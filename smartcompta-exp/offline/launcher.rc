#include <winver.h>
1 ICON "smartcompta.ico"
1 VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "SmartCompta Exp"
      VALUE "FileDescription", "SmartCompta Exp - comptabilite SYSCOHADA hors ligne"
      VALUE "FileVersion", "1.2.0"
      VALUE "InternalName", "SmartCompta Exp"
      VALUE "OriginalFilename", "SmartCompta Exp.exe"
      VALUE "ProductName", "SmartCompta Exp"
      VALUE "ProductVersion", "1.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
